<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#1E2126"
                android:centerColor="#15171B"
                android:endColor="#0B0D10" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#3A3D42" />
        </shape>
    </item>
    <item android:drawable="@drawable/oanix_launcher_foreground_vector" />
</layer-list>
