{
  "name": "oanix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode capacitor",
    "audit:offline-bundle": "node scripts/audit-offline-bundle.mjs",
    "android:sync": "npm run build:android && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@supabase/supabase-js": "^2.57.4",
    "hash-wasm": "4.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sortablejs": "1.15.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
